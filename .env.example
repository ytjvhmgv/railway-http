# ===== HTTP proxy auth (required) =====
PROXY_USER=myuser
PROXY_PASS=replace-with-strong-password

# ===== CF+WS recommended: paste full share link =====
# vless://uuid@172.64.x.x:443?encryption=none&security=tls&sni=domain&fp=random&type=ws&host=domain&path=%2Fproxyip%3DIP%3APORT#JP
VLESS_LINK=

# Optional overrides only (leave empty to keep values from VLESS_LINK)
# VLESS_FINGERPRINT=chrome
# VLESS_ALLOW_INSECURE=false
# VLESS_SNI=
# VLESS_HOST=
# VLESS_PATH=

# ===== Or configure manually without VLESS_LINK =====
# VLESS_UUID=
# VLESS_SERVER=172.64.229.185
# VLESS_PORT=443
# VLESS_NETWORK=ws
# VLESS_SECURITY=tls
# VLESS_SNI=kd.example.com
# VLESS_HOST=kd.example.com
# VLESS_PATH=/proxyip=1.2.3.4:16000
# VLESS_FINGERPRINT=random
# VLESS_ALLOW_INSECURE=false
